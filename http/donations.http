### Tnal Youth — Donation API smoke tests
### Works in IntelliJ HTTP Client and VS Code "REST Client".
### Run top-to-bottom: login first (captures the token), then the rest.
###
### Replace the login values with active local test accounts. Migration V309
### intentionally disabled the old shared demo password.

@baseUrl = http://localhost:8081
@adminEmail = admin1@gmail.com
@memberEmail = member1@gmail.com
@password = CHANGE_ME

### -------------------------------------------------------------------------
### 1. Login as ADMIN — captures {{adminToken}} (LoginResponse is UNWRAPPED).
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phoneOrEmail": "{{adminEmail}}",
  "password": "{{password}}"
}

> {%
    client.global.set("adminToken", response.body.accessToken);
    client.test("admin login ok", () => {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.accessToken != null, "no accessToken");
    });
%}

### -------------------------------------------------------------------------
### 2. Login as MEMBER — captures {{memberToken}} (used for the 403 check).
# @name loginMember
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phoneOrEmail": "{{memberEmail}}",
  "password": "{{password}}"
}

> {% client.global.set("memberToken", response.body.accessToken); %}

### -------------------------------------------------------------------------
### 3. CREATE — sponsor donation, KHR + USD mixed. Captures {{donationId}}.
###    total_amount_usd is computed server-side: 25.00 + 100000/4100 = 49.39
# @name createMixed
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "sponsorId": 1,
  "branchId": 1,
  "amountKhr": 100000.00,
  "amountUsd": 25.00,
  "exchangeRateKhrPerUsd": 4100.0000,
  "paymentMethodId": 2,
  "paidAt": "2026-07-24T09:00:00Z",
  "paymentReference": "ABA-TXN-0001",
  "note": "Quarterly sponsor gift"
}

> {%
    client.global.set("donationId", response.body.data.id);
    client.test("create ok + server total", () => {
        client.assert(response.status === 200, "expected 200");
        client.assert(response.body.data.donationNo != null, "no donationNo");
        client.assert(response.body.data.totalAmountUsd === "49.39", "USD total not computed");
    });
%}

### -------------------------------------------------------------------------
### 4. CREATE — anonymous walk-in donor (donor_name only), cash, USD only.
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "donorName": "Walk-in donor",
  "branchId": 1,
  "amountUsd": 10.00,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:15:00Z"
}

### -------------------------------------------------------------------------
### 5. NEGATIVE — two donor sources at once -> 400 DONATION_SOURCE_INVALID.
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "sponsorId": 1,
  "donorName": "Also a name",
  "branchId": 1,
  "amountUsd": 5.00,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:20:00Z"
}

> {% client.test("rejected", () => client.assert(response.status === 400, "expected 400")); %}

### -------------------------------------------------------------------------
### 6. NEGATIVE — KHR present but no exchange rate -> 400 DONATION_EXCHANGE_RATE_REQUIRED.
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "donorName": "No rate donor",
  "branchId": 1,
  "amountKhr": 40000.00,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:25:00Z"
}

> {% client.test("rejected", () => client.assert(response.status === 400, "expected 400")); %}

### -------------------------------------------------------------------------
### 7. NEGATIVE — MEMBER cannot record donations -> 403.
POST {{baseUrl}}/api/donations
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "donorName": "Blocked",
  "branchId": 1,
  "amountUsd": 1.00,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:30:00Z"
}

> {% client.test("forbidden", () => client.assert(response.status === 403, "expected 403")); %}

### -------------------------------------------------------------------------
### 8. IDEMPOTENCY — same clientRequestId twice returns the SAME donation.
# @name idem1
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "donorName": "Idem donor",
  "branchId": 1,
  "amountUsd": 7.50,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:35:00Z",
  "clientRequestId": "11111111-1111-1111-1111-111111111111"
}

> {% client.global.set("idemId", response.body.data.id); %}

###
POST {{baseUrl}}/api/donations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "donorName": "Idem donor",
  "branchId": 1,
  "amountUsd": 7.50,
  "paymentMethodId": 1,
  "paidAt": "2026-07-24T10:35:00Z",
  "clientRequestId": "11111111-1111-1111-1111-111111111111"
}

> {%
    client.test("idempotent replay", () =>
        client.assert(response.body.data.id === client.global.get("idemId"), "different id -> not idempotent"));
%}

### -------------------------------------------------------------------------
### 9. GET one.
GET {{baseUrl}}/api/donations/{{donationId}}
Authorization: Bearer {{adminToken}}

### -------------------------------------------------------------------------
### 10. LIST — filtered by branch + date range, paged.
GET {{baseUrl}}/api/donations?branchId=1&paidFrom=2026-07-01T00:00:00Z&paidTo=2026-07-31T23:59:59Z&page=0&size=20
Authorization: Bearer {{adminToken}}

### -------------------------------------------------------------------------
### 11. SUMMARY — totals over the same filter set.
GET {{baseUrl}}/api/donations/summary?branchId=1&paidFrom=2026-07-01T00:00:00Z&paidTo=2026-07-31T23:59:59Z
Authorization: Bearer {{adminToken}}

### -------------------------------------------------------------------------
### 12. UPDATE — correct the amount (recomputes total_amount_usd).
PUT {{baseUrl}}/api/donations/{{donationId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "donationTypeId": 3,
  "sponsorId": 1,
  "branchId": 1,
  "amountKhr": 0,
  "amountUsd": 30.00,
  "paymentMethodId": 2,
  "paidAt": "2026-07-24T09:00:00Z",
  "paymentReference": "ABA-TXN-0001-CORRECTED",
  "note": "Corrected to USD-only"
}

### -------------------------------------------------------------------------
### 13. DELETE — ADMIN only.
DELETE {{baseUrl}}/api/donations/{{donationId}}
Authorization: Bearer {{adminToken}}
