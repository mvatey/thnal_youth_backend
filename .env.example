# Create a file named .env in the project root and fill in your actual DB credentials.
# OR run: cp .env.example .env
# Then edit .env with your real values.

POSTGRES_DB=your_db_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Only needed when the DB isn't on localhost:5433 (e.g. Railway Postgres —
# set these to the Railway Postgres plugin's PGHOST / PGPORT).
# DB_HOST=your_db_host
# DB_PORT=your_db_port

CORS_ALLOWED_ORIGINS=http://localhost:3000
