# Create a file named .env in the project root and fill in your actual DB credentials.
# OR run: cp .env.example .env
# Then edit .env with your real values.

POSTGRES_DB=your_db_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Only needed when the DB isn't on localhost:5433 (e.g. Railway Postgres —
# set these to the Railway Postgres plugin's PGHOST / PGPORT).
# DB_HOST=your_db_host
# DB_PORT=your_db_port

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- File storage ---
# "local" (default) writes uploaded photos/documents to this server's own
# disk -- no AWS account needed. LOCAL_STORAGE_ROOT_DIR MUST be an absolute
# path OUTSIDE this project folder (a dedicated data directory/volume) --
# never a relative path like ./uploads, which lives inside the project
# checkout and would be wiped out by a redeploy/`git clean`, or accidentally
# picked up by `git add -A`. Example for a Windows server:
# STORAGE_TYPE=local
# LOCAL_STORAGE_ROOT_DIR=D:\tnal-youth-uploads
# On Linux, use an absolute path like /var/data/tnal-youth-uploads instead.
# Set STORAGE_TYPE=s3 instead only if you specifically want AWS S3 (see
# application.properties for what else that needs).
